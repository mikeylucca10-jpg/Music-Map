# Copy this file to .env.local and fill in real values (.env.local is gitignored).

# Get a free key at https://developer.ticketmaster.com/ (Apps > New App)
EXPO_PUBLIC_TICKETMASTER_API_KEY=

# Optional: request access at https://edmtrain.com/page/api — until approved,
# leave blank and EDMTrain results are skipped.
EXPO_PUBLIC_EDMTRAIN_API_KEY=

# From your Supabase project's Settings > API page: https://supabase.com/dashboard
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
