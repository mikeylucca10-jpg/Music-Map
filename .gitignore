.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# personal Claude Code overrides
.claude/settings.local.json

# vendored third-party design skills (~10MB, MIT/Apache).
# Local tooling, not app code — see .claude/skills/README.md to reinstall.
.claude/skills/*
# ...but keep the reinstall instructions tracked, or they vanish with the folder.
!.claude/skills/README.md

# typescript
*.tsbuildinfo

example

